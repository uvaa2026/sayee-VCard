<?xml version="1.0" encoding="utf-8"?>
<!-- Only needed if you host on Azure App Service (Windows) instead of Static Web Apps -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".vcf" />
      <mimeMap fileExtension=".vcf" mimeType="text/vcard" />
    </staticContent>
    <defaultDocument>
      <files><clear /><add value="index.html" /></files>
    </defaultDocument>
  </system.webServer>
</configuration>
